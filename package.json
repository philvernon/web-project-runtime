{
  "name": "@philvernon/web-project-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi-backed web builder with conversation UI, bounded generation and isolated previews",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.19.1",
  "files": [
    "dist",
    "README.md",
    "docs/builder-api.md"
  ],
  "exports": {
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "prepare": "npm run build",
    "check": "npm run check:boundaries && npm run lint && npm run typecheck:examples && npm run format:check",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p examples/shared/tsconfig.json",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write src tests scripts examples docs .github *.json *.md",
    "format:check": "prettier --check src tests scripts examples docs .github *.json *.md",
    "test": "vitest run",
    "test:distribution": "tsx tests/distribution.ts",
    "test:browser": "tsx tests/browser.ts && tsx tests/builder-browser.ts",
    "test:examples": "tsx tests/examples-host.ts && tsx tests/examples-browser.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
