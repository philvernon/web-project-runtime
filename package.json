{
  "name": "@philvernon/web-project-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded generated web projects compiled into isolated browser artifacts",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.19.1",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "npm run lint && npm run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write src tests *.json *.md",
    "format:check": "prettier --check src tests *.json *.md",
    "test": "vitest run",
    "test:distribution": "tsx tests/distribution.ts",
    "test:browser": "tsx tests/browser.ts"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
